# ── Auth (optional — leave empty to keep API open) ──
THREADWEAVE_REQUIRE_AUTH=***
THREADWEAVE_API_KEYS=***

# ── LLM Detection (optional — leave empty for regex) ──
# When configured, the email connector classifies with the LLM (multilingual,
# e.g. Norwegian) instead of the English-only regex engine. Leave empty to
# stay on regex (deterministic, free, English-only classification).
# OpenAI
# THREADWEAVE_LLM_API_KEY=***
# THREADWEAVE_LLM_MODEL=gpt-4o-mini
# Local Ollama (set provider=ollama; the detector uses Ollama's native
# /api/chat endpoint, so "thinking" models like qwen3.5 work correctly)
# THREADWEAVE_LLM_PROVIDER=ollama
# THREADWEAVE_LLM_BASE_URL=http://localhost:11434/v1
# THREADWEAVE_LLM_MODEL=qwen3.5:9b

# ── Port ──
THREADWEAVE_PORT=8000

# ── Email harvest thresholds (pilot calibration) ──
# Save threshold: emails classified ANSWER/DECISION with confidence below
# this are skipped. Lower = save more (noisier), higher = save less (leaner).
# THREADWEAVE_EMAIL_MIN_CONFIDENCE=0.40
# Skip email bodies shorter than this many characters.
# THREADWEAVE_EMAIL_MIN_BODY_LENGTH=100