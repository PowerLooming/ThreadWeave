# MemPalace MCP Dockerfile
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir mempalace

VOLUME ["/data", "/palace"]

EXPOSE 8001

CMD ["mempalace-mcp", "--palace", "/palace"]
